@model IEnumerable<TodoListApp.Models.TaskItem>

@{
    ViewData["Title"] = "Список задач";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Мой список задач</h1>
            <p class="text-muted mb-0">
                Невыполненных задач: @ViewBag.UncompletedCount
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Добавить задачу
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get"
                  class="d-flex flex-wrap gap-3 align-items-end">

                <div>
                    <label class="form-label">Статус</label>
                    <select name="status" class="form-select">
                        <option value="">Все задачи</option>
                        <option value="active"
                                selected="@(ViewBag.Status == "active")">
                            Невыполненные
                        </option>
                        <option value="completed"
                                selected="@(ViewBag.Status == "completed")">
                            Выполненные
                        </option>
                    </select>
                </div>

                <div>
                    <label class="form-label">Сортировка</label>
                    <select name="sortOrder" class="form-select">
                        <option value="newest"
                                selected="@(ViewBag.SortOrder != "oldest")">
                            Сначала новые
                        </option>
                        <option value="oldest"
                                selected="@(ViewBag.SortOrder == "oldest")">
                            Сначала старые
                        </option>
                    </select>
                </div>

                <button type="submit" class="btn btn-outline-primary">
                    Применить
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Сбросить
                </a>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Задач пока нет. Добавь свою первую задачу!
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Название</th>
                        <th>Описание</th>
                        <th>Дата создания</th>
                        <th>Статус</th>
                        <th style="min-width: 250px;">Действия</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var task in Model)
                    {
                        <tr>
                            <td>
                                @if (task.IsCompleted)
                                {
                                    <span class="text-decoration-line-through text-muted">
                                        @task.Title
                                    </span>
                                }
                                else
                                {
                                    <strong>@task.Title</strong>
                                }
                            </td>

                            <td>@task.Description</td>

                            <td>@task.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>

                            <td>
                                @if (task.IsCompleted)
                                {
                                    <span class="badge bg-success">
                                        Выполнена
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        В процессе
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <form asp-action="ToggleComplete"
                                          asp-route-id="@task.Id"
                                          method="post">
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-success">
                                            @(task.IsCompleted
                                                ? "Вернуть"
                                                : "Выполнить")
                                        </button>
                                    </form>

                                    <a asp-action="Edit"
                                       asp-route-id="@task.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Изменить
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@task.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Удалить
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>